# PostgreSQL 18 Connection Settings for SKY WINGS
# Enter your local PostgreSQL credentials in your private .env file
PGHOST=localhost
PGPORT=5432
PGDATABASE=airline_reservation
PGUSER=postgres
PGPASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD
PORT=3000
CLIENT_ORIGIN=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_BOOTSTRAP_MODE=false

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
